<idea-plugin>
    <depends>com.intellij.modules.platform</depends>
    <incompatible-with>net.blendbyte.openvox</incompatible-with>

    <description><![CDATA[
      <p>Language tools for <b>OpenVox</b> and Puppet manifests (<code>.pp</code>), with
      completion, navigation, refactoring, and EPP template editing (<code>.epp</code>).
      Supports OpenVox 8 and
      OpenVox 9 prereleases (checked against 9.0.0-rc1).</p>
      <ul>
        <li><b>Editing</b> - syntax highlighting with a configurable colour scheme, brace
            matching, folding, live templates and a structure view.</li>
        <li><b>Formatting</b> - aligns the <code>=&gt;</code> of every attribute in a resource
            body, hash and selector, as the style guide requires, with its own code style page.</li>
        <li><b>Navigation</b> - go to the declaration of a class, defined type, function, type
            alias, parameter or variable; find usages; rename; Go to Class and Go to Symbol;
            jump from <code>epp()</code>, <code>template()</code> and <code>source =&gt;</code>
            to the file they name.</li>
        <li><b>Completion</b> - resource attributes and their allowed values, data types and
            type aliases, resource types, fact keys inside <code>$facts[...]</code>, built-in
            and project functions, and variables in scope.</li>
        <li><b>Quick documentation</b> for built-in functions, resource types, attributes and
            data types, with compatibility notes for OpenVox 8 and 9.</li>
        <li><b>Inspections</b> - unknown function, unknown attribute, unresolved variable,
            unused parameter, and legacy top-scope facts with a quick fix that rewrites them
            as <code>$facts[...]</code>.</li>
        <li><b>External validation</b> - optional <code>puppet parser validate</code> and
            <code>puppet-lint</code> integration.</li>
        <li>Modern language constructs throughout: parameterised data types such as
            <code>Optional[Variant[String[1], Enum['a','b']]]</code>, <code>Sensitive</code>,
            <code>Init</code>, type aliases, Puppet-language functions, lambdas, heredocs and
            EPP tags.</li>
      </ul>
      <p>This plugin is community-maintained and is not affiliated with Perforce or Vox Pupuli.</p>
    ]]></description>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="OpenVox" language="OpenVox" extensions="pp"
                  implementationClass="software.barad1tos.puppet.OpenVoxFileType" fieldName="INSTANCE"/>
        <fileType name="EPP" language="EPP" extensions="epp"
                  implementationClass="software.barad1tos.puppet.EppFileType" fieldName="INSTANCE"/>

        <lang.parserDefinition language="OpenVox"
                               implementationClass="software.barad1tos.puppet.parser.OpenVoxParserDefinition"/>
        <lang.parserDefinition language="EPP"
                               implementationClass="software.barad1tos.puppet.parser.EppParserDefinition"/>

        <lang.syntaxHighlighterFactory language="OpenVox"
                                       implementationClass="software.barad1tos.puppet.highlighting.OpenVoxSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="EPP"
                                       implementationClass="software.barad1tos.puppet.highlighting.EppSyntaxHighlighterFactory"/>

        <lang.commenter language="OpenVox" implementationClass="software.barad1tos.puppet.OpenVoxCommenter"/>
        <lang.braceMatcher language="OpenVox" implementationClass="software.barad1tos.puppet.OpenVoxBraceMatcher"/>

        <colorSettingsPage implementation="software.barad1tos.puppet.highlighting.OpenVoxColorSettingsPage"/>
        <lang.foldingBuilder language="OpenVox" implementationClass="software.barad1tos.puppet.editor.OpenVoxFoldingBuilder"/>
        <lang.foldingBuilder language="EPP" implementationClass="software.barad1tos.puppet.editor.OpenVoxFoldingBuilder"/>
        <lang.quoteHandler language="OpenVox" implementationClass="software.barad1tos.puppet.editor.OpenVoxQuoteHandler"/>
        <lang.psiStructureViewFactory language="OpenVox"
                                      implementationClass="software.barad1tos.puppet.structure.OpenVoxStructureViewFactory"/>
        <liveTemplateContext contextId="OpenVox"
                             implementation="software.barad1tos.puppet.editor.OpenVoxLiveTemplateContext"/>
        <defaultLiveTemplates file="/liveTemplates/OpenVox.xml"/>
        <fileBasedIndex implementation="software.barad1tos.puppet.index.OpenVoxDeclarationIndex"/>
        <fileBasedIndex implementation="software.barad1tos.puppet.index.OpenVoxHieraIndex"/>
        <fileBasedIndex implementation="software.barad1tos.puppet.index.OpenVoxRubyFunctionIndex"/>
        <psi.referenceContributor language="OpenVox"
                                  implementation="software.barad1tos.puppet.resolve.OpenVoxReferenceContributor"/>
        <psi.referenceContributor language="EPP"
                                  implementation="software.barad1tos.puppet.resolve.OpenVoxReferenceContributor"/>
        <lang.findUsagesProvider language="OpenVox"
                                 implementationClass="software.barad1tos.puppet.resolve.OpenVoxFindUsagesProvider"/>
        <referencesSearch implementation="software.barad1tos.puppet.resolve.OpenVoxReferenceSearcher"/>
        <gotoClassContributor implementation="software.barad1tos.puppet.resolve.OpenVoxGotoClassContributor"/>
        <gotoSymbolContributor implementation="software.barad1tos.puppet.resolve.OpenVoxGotoSymbolContributor"/>
        <completion.contributor language="OpenVox"
                                implementationClass="software.barad1tos.puppet.completion.OpenVoxCompletionContributor"/>
        <completion.contributor language="EPP"
                                implementationClass="software.barad1tos.puppet.completion.OpenVoxCompletionContributor"/>
        <lang.documentationProvider language="OpenVox"
                                    implementationClass="software.barad1tos.puppet.completion.OpenVoxDocumentationProvider"/>
        <lang.documentationProvider language="EPP"
                                    implementationClass="software.barad1tos.puppet.completion.OpenVoxDocumentationProvider"/>
        <psi.referenceContributor language="OpenVox"
                                  implementation="software.barad1tos.puppet.project.OpenVoxProjectReferenceContributor"/>
        <codeInsight.lineMarkerProvider language="OpenVox"
                                        implementationClass="software.barad1tos.puppet.project.OpenVoxHieraLineMarkerProvider"/>
        <localInspection language="OpenVox" shortName="OpenVoxUnknownFunction"
                         displayName="Unknown function" groupName="OpenVox"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="software.barad1tos.puppet.inspections.OpenVoxUnknownFunctionInspection"/>
        <localInspection language="OpenVox" shortName="OpenVoxUnknownAttribute"
                         displayName="Unknown resource attribute" groupName="OpenVox"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="software.barad1tos.puppet.inspections.OpenVoxUnknownAttributeInspection"/>
        <localInspection language="OpenVox" shortName="OpenVoxUnresolvedVariable"
                         displayName="Unresolved variable" groupName="OpenVox"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="software.barad1tos.puppet.inspections.OpenVoxUnresolvedVariableInspection"/>
        <localInspection language="OpenVox" shortName="OpenVoxLegacyFact"
                         displayName="Legacy top-scope fact" groupName="OpenVox"
                         enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="software.barad1tos.puppet.inspections.OpenVoxLegacyFactInspection"/>
        <localInspection language="OpenVox" shortName="OpenVoxUnusedParameter"
                         displayName="Unused parameter" groupName="OpenVox"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="software.barad1tos.puppet.inspections.OpenVoxUnusedParameterInspection"/>

        <externalAnnotator language="OpenVox"
                           implementationClass="software.barad1tos.puppet.annotator.OpenVoxExternalAnnotator"/>
        <applicationConfigurable parentId="tools" instance="software.barad1tos.puppet.settings.OpenVoxConfigurable"
                                 id="software.barad1tos.puppet.settings" displayName="OpenVox / Puppet"/>
        <lang.formatter language="OpenVox"
                        implementationClass="software.barad1tos.puppet.formatting.OpenVoxFormattingModelBuilder"/>
        <codeStyleSettingsProvider
            implementation="software.barad1tos.puppet.formatting.OpenVoxCodeStyleSettingsProvider"/>
        <langCodeStyleSettingsProvider
            implementation="software.barad1tos.puppet.formatting.OpenVoxLanguageCodeStyleSettingsProvider"/>
    </extensions>
</idea-plugin>
